{
  "name": "Ventry AI — Chat Lead Capture",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ventry-lead-capture",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"status\": \"received\", \"timestamp\": \"{{ $now.toISO() }}\"}",
        "options": {}
      },
      "id": "respond-ok",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [475, 175]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "name",
              "name": "Name",
              "value": "={{ $json.body.name || $json.body.lead?.name || 'Unknown' }}",
              "type": "string"
            },
            {
              "id": "business",
              "name": "Business",
              "value": "={{ $json.body.business || $json.body.lead?.business || 'Unknown' }}",
              "type": "string"
            },
            {
              "id": "phone",
              "name": "Phone",
              "value": "={{ $json.body.phone || $json.body.lead?.phone || '' }}",
              "type": "string"
            },
            {
              "id": "email",
              "name": "Email",
              "value": "={{ $json.body.email || $json.body.lead?.email || '' }}",
              "type": "string"
            },
            {
              "id": "service_needed",
              "name": "Service Needed",
              "value": "={{ $json.body.service_needed || $json.body.lead?.service_needed || '' }}",
              "type": "string"
            },
            {
              "id": "source",
              "name": "Source",
              "value": "={{ $json.body.source || 'voiceflow-chat' }}",
              "type": "string"
            },
            {
              "id": "page_url",
              "name": "Page URL",
              "value": "={{ $json.body.page_url || 'ventryxai.com' }}",
              "type": "string"
            },
            {
              "id": "timestamp",
              "name": "Timestamp",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "parse-lead",
      "name": "Parse Lead Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [475, 425]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "",
          "mode": "list"
        },
        "sheetName": {
          "__rl": true,
          "value": "",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Name": "={{ $json.Name }}",
            "Business": "={{ $json.Business }}",
            "Phone": "={{ $json.Phone }}",
            "Email": "={{ $json.Email }}",
            "Service Needed": "={{ $json['Service Needed'] }}",
            "Source": "={{ $json.Source }}",
            "Page URL": "={{ $json['Page URL'] }}",
            "Timestamp": "={{ $json.Timestamp }}"
          },
          "matchingColumns": []
        },
        "options": {}
      },
      "id": "google-sheets",
      "name": "Append to Google Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [700, 300]
    },
    {
      "parameters": {
        "sendTo": "evan@ventryxai.com",
        "subject": "=New Lead from Ventry AI: {{ $json.Name }} ({{ $json.Business }})",
        "message": "=<h2>New Lead Captured</h2><table style=\"border-collapse:collapse;font-family:sans-serif;\"><tr><td style=\"padding:8px;font-weight:bold;\">Name</td><td style=\"padding:8px;\">{{ $json.Name }}</td></tr><tr><td style=\"padding:8px;font-weight:bold;\">Business</td><td style=\"padding:8px;\">{{ $json.Business }}</td></tr><tr><td style=\"padding:8px;font-weight:bold;\">Phone</td><td style=\"padding:8px;\">{{ $json.Phone }}</td></tr><tr><td style=\"padding:8px;font-weight:bold;\">Email</td><td style=\"padding:8px;\">{{ $json.Email }}</td></tr><tr><td style=\"padding:8px;font-weight:bold;\">Service Needed</td><td style=\"padding:8px;\">{{ $json['Service Needed'] }}</td></tr><tr><td style=\"padding:8px;font-weight:bold;\">Page</td><td style=\"padding:8px;\">{{ $json['Page URL'] }}</td></tr><tr><td style=\"padding:8px;font-weight:bold;\">Source</td><td style=\"padding:8px;\">{{ $json.Source }}</td></tr><tr><td style=\"padding:8px;font-weight:bold;\">Time</td><td style=\"padding:8px;\">{{ $json.Timestamp }}</td></tr></table>",
        "options": {}
      },
      "id": "send-email",
      "name": "Email Alert to Evan",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [925, 300]
    }
  ],
  "connections": {
    "Lead Webhook": {
      "main": [
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          },
          {
            "node": "Parse Lead Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Lead Data": {
      "main": [
        [
          {
            "node": "Append to Google Sheet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Append to Google Sheet": {
      "main": [
        [
          {
            "node": "Email Alert to Evan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}
